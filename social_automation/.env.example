# Bastet Yazılım Sosyal Medya Otomasyonu - Meta API Yapılandırması
# Bu dosyayı kopyalayıp '.env' olarak kaydedin ve bilgilerinizi doldurun.

# Meta Graph API Sürümü
META_API_VERSION=v21.0

# Meta Geliştirici Portalından (developers.facebook.com) alınan kalıcı sayfa erişim tokenı:
META_ACCESS_TOKEN=your_meta_access_token_here

# Instagram Profesyonel / İçerik Üretici Hesap ID:
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here

# Facebook Sayfa ID:
FACEBOOK_PAGE_ID=your_facebook_page_id_here
